#I got these values from Paymob Dashboard > Settings / Developers.

# Classic "Accept" API key (used for /api/auth/tokens)
PAYMOB_API_KEY= PAYMOB API KEY

# Secret key (used as "Token <secret_key>" bearer auth for the newer
# Subscriptions / Intention APIs).
PAYMOB_SECRET_KEY= SECRET KEY

# Public key (used client-side for unified checkout / intention flows, if needed)
PAYMOB_PUBLIC_KEY= PUBLIC KEY

# HMAC secret used to verify webhook/callback authenticity
PAYMOB_HMAC_SECRET= HMAC SECRET

# Integration ID for a normal CARD integration (3DS/CIT) — used ONLY to
# tokenize a card while the customer is present (the /checkout flow).
PAYMOB_INTEGRATION_ID= INTEGRATION ID

# Integration ID for your MOTO / MIT integration — used to actually bill the
# subscription on each cycle without the customer present. This is the id
# that goes into the subscription plan itself.
PAYMOB_MOTO_INTEGRATION_ID= MOTO ID

# Iframe ID shown in Paymob dashboard > Developers > Iframes
PAYMOB_IFRAME_ID= IFrame_ID

# Base URL for Egypt region.
PAYMOB_BASE_URL= Paymob Base URL

# Currency used across requests
PAYMOB_CURRENCY=EGP

# Public ngrok URL, filled in after you run `ngrok http 5000`
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
